# ===========================================
# COMPASS — Environment
# ===========================================
# Copy this file to .env:  cp .env.example .env
# For development/prototype: works as-is, no changes needed.
# For production: replace shared keys with strong random keys.
# NEVER commit .env to git.
# ===========================================

# --- PostgreSQL ---
POSTGRES_USER=prostatecancer_user
POSTGRES_PASSWORD=secure_password_123
POSTGRES_DB=prostatecancer_db

# --- Backend API ---
API_KEY=sk_live_046b82a85160b27608b0ccfb357fe7ef54b0b523b1737871
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Authentication ---
# AUTH_MODE: api_key (default) | multi_key | jwt | oauth2
AUTH_MODE=api_key
# JWT_SECRET=CHANGE_ME_jwt_secret        # Required for jwt/multi_key modes
# JWT_ALGORITHM=HS256                     # JWT signing algorithm
# JWT_EXPIRE_MINUTES=60                   # JWT token expiration
# OAUTH2_ISSUER=                          # OAuth2 IdP issuer URL (e.g. https://accounts.google.com)
# OAUTH2_CLIENT_ID=                       # OAuth2 client ID
# OAUTH2_CLIENT_SECRET=                   # OAuth2 client secret
# OAUTH2_AUDIENCE=                        # OAuth2 audience (optional)

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8080"]

# --- Upload ---
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=["csv", "xlsx"]

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- Pagination ---
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000

# --- Workers ---
WEB_CONCURRENCY=3

# --- REDCap (Cedars-Sinai iREDCap) ---
REDCAP_ENABLED=True
REDCAP_API_URL=https://iredcap.csmc.edu/api/
REDCAP_API_TOKEN=

# --- Azure OpenAI (AI Pipeline — GPT-4o scoring + patient summary) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_MODEL=

# --- Frontend (passed to Webapp at build time) ---
# POSTHOG_KEY=                             # PostHog analytics project key
# POSTHOG_HOST=https://app.posthog.com     # PostHog host URL
# OPENAI_API_KEY=                           # OpenAI API key (for AI report generation)
