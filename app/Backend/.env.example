# ===========================================
# Prostate Cancer Dashboard — Environment
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to git.
# ===========================================

# --- PostgreSQL ---
POSTGRES_USER=prostatecancer_user
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password
POSTGRES_DB=prostatecancer_db

# --- Backend API ---
API_KEY=CHANGE_ME_generate_a_random_key
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
SECRET_KEY=CHANGE_ME_generate_a_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Authentication ---
# AUTH_MODE: api_key (default) | multi_key | jwt | oauth2
AUTH_MODE=api_key
# JWT_SECRET=CHANGE_ME_jwt_secret        # Required for jwt/multi_key modes
# JWT_ALGORITHM=HS256                     # JWT signing algorithm
# JWT_EXPIRE_MINUTES=60                   # JWT token expiration
# OAUTH2_ISSUER=                          # OAuth2 IdP issuer URL (e.g. https://accounts.google.com)
# OAUTH2_CLIENT_ID=                       # OAuth2 client ID
# OAUTH2_CLIENT_SECRET=                   # OAuth2 client secret
# OAUTH2_AUDIENCE=                        # OAuth2 audience (optional)

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8080"]

# --- Upload ---
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=["csv", "xlsx"]

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- Pagination ---
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000

# --- Workers ---
WEB_CONCURRENCY=3

# --- REDCap ---
REDCAP_ENABLED=True
REDCAP_API_URL=https://your-redcap-instance.example.com/api/
REDCAP_API_TOKEN=CHANGE_ME_your_redcap_token

# --- Frontend (passed to Webapp at build time) ---
# POSTHOG_KEY=                             # PostHog analytics project key
# POSTHOG_HOST=https://app.posthog.com     # PostHog host URL
# OPENAI_API_KEY=                           # OpenAI API key (for AI report generation)
