# =============================================================================
# Native deployment env template
#
# Copy to .env.native and fill in real values:
#   cp app/Backend/.env.native.example app/Backend/.env.native
#
# .env.native is gitignored (see top-level .gitignore: *.native pattern).
# Do NOT commit real credentials.
#
# ⚠️ DEFAULTS BELOW ARE FOR LOCAL DEVELOPMENT ONLY ⚠️
# Most variables ship with sensible defaults so a fresh `cp` + `init-db-native.sh`
# boots the stack on a workstation. Before deploying anywhere shared
# (staging, production, even a colleague's machine) you MUST review every
# section and change at minimum:
#   - POSTGRES_PASSWORD : pick a strong secret, never leave as CHANGE_ME
#   - API_KEY           : generate fresh per environment (`openssl rand -hex 32`)
#   - AZURE_OPENAI_*    : use YOUR Azure OpenAI resource — placeholders below
#                         do nothing on their own
# Treat the rest (POSTGRES_USER, POSTGRES_DB, ports, NLP_API_URL) as the
# project's chosen convention — change only if your environment forces it.
#
# Reference: dev_docs/DEPLOYMENT_NATIVE_PLAN.md
# =============================================================================

# ── Database (native PostgreSQL on the host) ─────────────────────────────────
# postgresql@16 installed via brew (macOS) or apt (Linux).
# Native uses 5433 (auto-configured by setup-native-mac.sh) so it can
# coexist with system EDB-style installs that grab 5432, and with our
# Docker mode which uses 5432.
#
# `init-db-native.sh` will create the role + database below using these values,
# so you only need to fill in POSTGRES_PASSWORD with `openssl rand -hex 16`.
DATABASE_URL=postgresql+asyncpg://prostatecancer_user:CHANGE_ME@localhost:5433/prostatecancer_db_native
DATABASE_URL_SYNC=postgresql+psycopg2://prostatecancer_user:CHANGE_ME@localhost:5433/prostatecancer_db_native

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=prostatecancer_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=prostatecancer_db_native

# ── Redis (native on the host) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── NLP classifiers (kept as Docker, exposed to the host) ────────────────────
# docker-compose-minimal.yml binds the container to 127.0.0.1:8888
# (8001 is commonly squatted by VS Code extensions; 8888 was picked to dodge that).
NLP_API_URL=http://localhost:8888

# ── Azure OpenAI (for the AI sub-pipeline) ───────────────────────────────────
# ⚠️ REQUIRED for the AI 5-substep pipeline (scoring → extraction → filtering →
# selection → reformat). The placeholders below DO NOT WORK — they are not a
# shared dev key, and there is no fallback. With these values left as-is:
#   - `run-pipeline-standalone.py` (default) returns 503 on any AI call
#   - the dashboard's "Try & Score" button returns 503
#   - any patient analysis triggered from the UI fails at the AI step
# Provide YOUR OWN endpoint + key from your organisation's Azure subscription.
# (Cannot find them? Azure portal → Cognitive Services → your OpenAI resource →
#  Keys and Endpoint.)
#
# To skip the AI pipeline entirely (NLP-only — useful for fast iteration without
# Azure cost), pass `--skip-ai` to run-pipeline-standalone.py instead of editing
# this section.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_KEY=YOUR_KEY_HERE
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_MODEL=gpt-4o

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000

# ⚠️ MUST BE CHANGED. Used for the X-API-Key header on every backend request
# from the webapp. Generate fresh per environment with `openssl rand -hex 32`.
# If left as CHANGE_ME the value still loads, but anyone who can read this
# file (or any deploy artifact) can forge requests.
API_KEY=CHANGE_ME_generate_a_random_key

# CORS — allow webapp Docker (host.docker.internal) to call native backend.
# Wrap the JSON in single quotes so `set -a; source` does not strip them.
CORS_ORIGINS='["http://localhost:3001","http://127.0.0.1:3001","http://host.docker.internal:3001"]'

# ── Optional ─────────────────────────────────────────────────────────────────
# Skip the AI sub-pipeline when iterating on NLP only (saves Azure cost).
# SKIP_AI_PIPELINE=1

# Pipeline I/O — defaults to the sibling AI repo
# (assumes Prostate_cancer_consultation_dashboard/ and
#  AI_physician_patient_communication/ are cloned under the same parent dir).
# Relative paths are resolved against the dashboard repo root by config.py.
# Override with absolute paths if your layout differs.
TRANSCRIPTS_DIR=../AI_physician_patient_communication/data/input
OUTPUT_DIR=../AI_physician_patient_communication/data/output

# ── REDCap (Cedars-Sinai iREDCap survey sync) ────────────────────────────────
# When BOTH URL and TOKEN are set, every patient survey submission is
# automatically synced to iREDCap (in addition to the local
# `survey_submission_log` table). With either missing, sync is silently
# skipped — local DB still records the submission.
#
# Token: get from REDCap project page → Applications → API → Generate Token.
# Each project / environment should have its own token; do NOT reuse a
# production token for development.
#
# ⚠️ This token grants WRITE access to a real clinical research database.
# Treat it like a password. Never commit it; use the placeholder below in
# the template and fill in the real value only in `.env.native` (gitignored).
REDCAP_API_URL=https://iredcap.csmc.edu/api/
REDCAP_API_TOKEN=CHANGE_ME_redcap_project_api_token
