# Version control
.git
.gitignore

# Python artifacts
__pycache__
*.pyc
*.pyo
*.egg-info
.mypy_cache
.pytest_cache
.coverage
htmlcov

# Test files (not needed in production)
tests/
Test/
requirements-dev.txt

# Documentation (not needed in production)
*.md
dev_docs/

# IDE / Editor
.vscode
.idea
*.swp
*.swo

# Environment files (secrets — injected via docker-compose env_file)
.env
.env.*
!.env.example

# Local data / logs (mounted as volumes)
logs/
uploads/
data/

# Archives
archive/

# Docker files (no need to copy into the image)
Dockerfile
docker-compose.yml
.dockerignore
