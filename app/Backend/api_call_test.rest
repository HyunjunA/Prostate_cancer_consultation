# Verify that the API is functioning correctly at http://localhost:8000/docs , and then proceed to check the following as well.

@base = http://localhost:8000
@json = application/json
@api_key = REDACTED_API_KEY

# NLP Classifier API (r01-nlp Docker container)
# Run: docker run -d --name r01-nlp -p 8001:8000 r01-nlp-classifiers:latest
# Docs: http://localhost:8001/__docs__/
@nlp_base = http://localhost:8001


############################################################
