GET {{base}}/api/doctor/rewrites?file=quality-coded-nlp-pilot-sid-1.xlsx&speaker=Interviewer:
X-API-Key: {{api_key}}


############################################################
### 6) Doctor Interface - Get Rewrites (Pagination)
############################################################
GET {{base}}/api/doctor/rewrites?skip=0&limit=50
X-API-Key: {{api_key}}

