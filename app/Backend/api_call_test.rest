# Verify that the API is functioning correctly at http://localhost:8000/docs , and then proceed to check the following as well.
#
# API key is loaded from app/Backend/.env (the same file the backend uses).
# `{{$dotenv API_KEY}}` is a REST Client built-in that reads the named key
# from the nearest .env file. No edits to this file or to .vscode/ needed —
# the .env is already gitignored, so the secret stays local.

@base = http://localhost:8000
@json = application/json
@api_key = {{$dotenv API_KEY}}

# NLP Classifier API (r01-nlp Docker container)
# Run: docker run -d --name r01-nlp -p 8001:8000 r01-nlp-classifiers:latest
# Docs: http://localhost:8001/__docs__/
@nlp_base = http://localhost:8001


