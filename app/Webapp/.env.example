# Native-mode webapp config
# Loaded by docker-compose-minimal.yml; this file IS gitignored
# (matches the .env.* rule with !.env.*.example exception).
#
# In native mode the backend runs on the host (uvicorn :18000), so the
# webapp container reaches it via host.docker.internal:18000.

NEXT_PUBLIC_API_URL=http://host.docker.internal:18000
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Backend API key — the server-side proxy (src/app/api/backend/[...path]) injects
# this as X-API-Key on every backend call. MUST equal app/Backend/.env's API_KEY.
# Loaded via the compose env_file so `docker compose up` works WITHOUT sourcing
# any shell env. (Do NOT move this back to a `${API_KEY}` interpolation in
# docker-compose-frontend.yml — that injects an EMPTY key when the launcher is
# bypassed, which shows up as a blank dashboard / "Missing API Key".)
API_KEY=CHANGE_ME
