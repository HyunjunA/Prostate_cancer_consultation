# @huggingface/transformers pulls in onnxruntime-node, whose postinstall script
# downloads platform-native ONNX Runtime binaries (and fails outright on a CUDA 11
# host: "CUDA 11 binaries are not supported by this script yet").
#
# The webapp only ever runs inference in the browser, through onnxruntime-web
# (WASM / WebGPU). The Node binding is never imported — next.config.js also
# aliases it away so no bundle can reach it — so skipping its download is not a
# trade-off, it just avoids fetching ~100 MB we would never load.
onnxruntime-node-install-cuda=skip
