@base = http://localhost:8000
@json = application/json


### Filter Options (static)
GET http://localhost:8000/api/studies/filter-options
accept: application/json

############################################################
### 0) Health / Readiness
############################################################
GET {{base}}/health

###
GET {{base}}/ready


############################################################
### 1) Dashboard stats
############################################################
GET {{base}}/api/dashboard/stats


############################################################
### 2) Filter options (static)
############################################################
GET {{base}}/api/studies/filter-options


############################################################
### 3) Filter (POST) — typical payload
# NOTE:
# - year_list must be an array (e.g., [2023])
# - countries is optional; remove or change as needed
############################################################
POST {{base}}/api/studies/filter?page=1&size=50
Content-Type: {{json}}

{
  "countries": ["United States"],
  "year_list": [2023],
  "age_reported": true,
  "gender_reported": true,
  "race_ethnicity_nationality_reported": true
}


############################################################
### 4) Aggregation (POST) — publication_year
############################################################
POST {{base}}/api/studies/aggregation/publication_year
Content-Type: {{json}}

{
  "countries": ["United States"],
  "year_list": [2023]
}


############################################################
### 5) Distinct (GET) — repository
# Allowed fields:
# covidence_id, pmid, study_id, title, publication_year,
# study_location_1, study_location_2, repository,
# age_reported, gender_reported, race_ethnicity_nationality_reported,
# comorbidities_reported, inpatient_outpatient_reported, outcomes_reported,
# severity_reported, signs_symptoms_reported, treatment_reported,
# vaccination_status_reported, sequence_ids_reported
############################################################
GET {{base}}/api/studies/distinct?field=repository


############################################################
### 6) Boolean stats (GET) — age_reported
# Allowed fields same as above boolean-like columns.
############################################################
GET {{base}}/api/studies/boolean-stats?field=age_reported


############################################################
### 7) Filter options (dynamic, POST)
# Matches StudyFilter schema — uses year_list (array), not 'year'
############################################################
POST {{base}}/api/studies/filter-options-dynamic
Content-Type: {{json}}

{
  "countries": ["United States"],
  "year_list": [2023],
  "age_reported": true,
  "gender_reported": true,
  "race_ethnicity_nationality_reported": true
}


############################################################
### 8) Quick list (GET) — pagination via limit/offset
############################################################
GET {{base}}/api/studies?limit=20&offset=0
